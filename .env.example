# Copy to .env (already gitignored) and fill in real values.
# Never commit .env -- only this template.

# https://the-odds-api.com/ API key. Used for:
#   - live current-week game odds (moneyline/spread/total, multi-book)
#   - player prop lines (passing/rushing/receiving yards, receptions, TDs)
# Optional: the system falls back to nflverse's schedule-embedded lines for
# game odds if unset, and player props are simply omitted (never faked).
ODDS_API_KEY=
